# ============================================================
# Example_2_BallMove.qsf
# Device : Cyclone IV E EP4CE10F17C8 (EP4CE10_Pro Board)
# Top    : Simple_VGA
#
# Hold SW2~SW5 (KEY1~KEY4) to move the ball; LED2~LED5 light
# while the corresponding key is held. (Board has 4 LEDs, so
# led5 is intentionally left unassigned.)
# ============================================================
set_global_assignment -name TOP_LEVEL_ENTITY Simple_VGA
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10F17C8

# 50MHz oscillator (Y7)
set_location_assignment PIN_E1 -to sys_clk
create_clock -period 20.000 [get_ports sys_clk]

# SW1 (RESET) - active low
set_location_assignment PIN_M15 -to sys_rst_n

# SW2~SW5 (KEY1~KEY4) - active low
set_location_assignment PIN_M2  -to up
set_location_assignment PIN_M1  -to down
set_location_assignment PIN_E15 -to left
set_location_assignment PIN_E16 -to right

# VGA connector
set_location_assignment PIN_C2 -to hsync
set_location_assignment PIN_D1 -to vsync

# LED2~LED5 - active low (0 = on)
set_location_assignment PIN_L7 -to led1
set_location_assignment PIN_M6 -to led2
set_location_assignment PIN_P3 -to led3
set_location_assignment PIN_N3 -to led4
# led5: not assigned - this board has only 4 user LEDs (LED2~LED5)
set_location_assignment PIN_A5 -to rgb_0
set_location_assignment PIN_B4 -to rgb_1[14]
set_location_assignment PIN_A2 -to rgb_1[13]
set_location_assignment PIN_B5 -to rgb_1[12]
set_location_assignment PIN_A6 -to rgb_1[11]
set_location_assignment PIN_B6 -to rgb_1[10]
set_location_assignment PIN_F6 -to rgb_1[9]
set_location_assignment PIN_F7 -to rgb_1[8]
set_location_assignment PIN_A7 -to rgb_1[7]
set_location_assignment PIN_B7 -to rgb_1[6]
set_location_assignment PIN_E8 -to rgb_1[5]
set_location_assignment PIN_F8 -to rgb_1[4]
set_location_assignment PIN_A8 -to rgb_1[3]
set_location_assignment PIN_B8 -to rgb_1[2]
set_location_assignment PIN_E7 -to rgb_1[1]
set_location_assignment PIN_E6 -to rgb_1[0]
